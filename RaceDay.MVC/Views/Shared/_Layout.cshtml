<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay — Find. Enter. Finish.</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
            :root {
                --bg: #070b18;
                --orange: #ff3c11;
                --lime: #d6ff00;
                --card: #11162a
            }

            body {
                background: var(--bg);
                font-family: 'Inter',sans-serif;
                color: white;
                overflow-x: hidden
            }

            .navbar-race {
                background: rgba(7,11,24,0.9);
                backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(255,255,255,0.08);
                padding: 14px 0
            }

            .logo {
                font-family: 'Bebas Neue';
                font-size: 32px;
                letter-spacing: 1px;
                line-height: 1;
                color: white !important
            }

                .logo span:last-child {
                    color: var(--orange) !important
                }

            .pill {
                font-size: 10px;
                font-weight: 900;
                letter-spacing: 1.5px;
                background: var(--lime);
                color: black;
                border-radius: 100px;
                padding: 6px 12px
            }

            .btn-blaze {
                background: var(--orange);
                color: white;
                font-weight: 900;
                border-radius: 100px;
                padding: 10px 22px;
                border: 0;
                transition: 0.2s
            }

                .btn-blaze:hover {
                    transform: translateY(-2px) scale(1.02);
                    box-shadow: 0 10px 30px rgba(255,60,17,0.4);
                    color: white
                }

            .btn-ghost {
                border: 1px solid rgba(255,255,255,0.2);
                color: white;
                font-weight: 700;
                border-radius: 100px;
                padding: 10px 22px;
                background: transparent
            }

                .btn-ghost:hover {
                    background: white;
                    color: black
                }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-race fixed-top">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand logo d-flex align-items-center gap-3" asp-controller="Home" asp-action="Index" style="color:white !important">
                    <span style="color:white">RACE</span><span style="color:var(--orange)">DAY</span> <span class="pill ms-2">SA • 2026</span>
                </a>
                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="text-white-50 small me-2">Hello @User.Identity.Name!</span>
                        <a class="btn-ghost text-decoration-none" asp-controller="Auth" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn-ghost text-decoration-none" asp-controller="Auth" asp-action="Login">Log in</a>
                        <a class="btn-blaze text-decoration-none ms-1" asp-controller="Auth" asp-action="Register">Sign up →</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main style="padding-top:72px">@RenderBody()</main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>