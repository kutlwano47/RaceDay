@model List<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Find. Enter. Finish.";
}

<style>
    body { background: #0a0a0f; margin:0; overflow-x:hidden; }
    .hero-title { font-size: 5rem; font-weight: 900; line-height: 0.9; letter-spacing: -2px; }
    .outline-text { -webkit-text-stroke: 1px #444; color: transparent; }
    .ticker { background: #1e3a8a; color: white; padding: 10px 0; white-space: nowrap; overflow: hidden; font-size: 12px; font-weight: bold; letter-spacing: 1px; }
    .stat-card { background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); border-radius: 12px; padding: 15px 20px; border: 1px solid rgba(255,255,255,0.1); }
    .race-card { background: #15151c; border: 1px solid #222; border-radius: 16px; color: white; transition:0.3s; }
    .race-card:hover { border-color: #ff5a30; transform: translateY(-4px); }
    .event-toast {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 1050;
        min-width: 300px;
        background: #d4ff00;
        color: #0a0a0f;
        border-radius: 14px;
        padding: 16px 20px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
        font-weight: 700;
        animation: toast-in 0.35s ease-out;
    }
    .event-toast button {
        float: right;
        border: 0;
        background: transparent;
        color: inherit;
        font-size: 20px;
        line-height: 1;
        margin-left: 16px;
    }
    @keyframes toast-in {
        from { opacity: 0; transform: translateY(-15px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@if (TempData["Success"] is string successMessage)
{
    <div id="eventCreatedToast" class="event-toast" role="status">
        <button type="button" aria-label="Close" onclick="this.parentElement.remove()">&times;</button>
        <span>✓ @successMessage</span>
    </div>
    <script>
        setTimeout(() => document.getElementById('eventCreatedToast')?.remove(), 5000);
    </script>
}

<!-- HERO - YOUR COOL MENU BACK -->
<div style="padding: 60px 40px 30px 60px; position:relative;">
    <span style="background:#d4ff00; color:black; font-size:10px; font-weight:900; padding:5px 12px; border-radius:20px; letter-spacing:1px;">LIVE EVENTS NEAR POLOKWANE</span>
    <span style="color:#777; font-size:10px; margin-left:10px; letter-spacing:2px;">EST. 2020</span>

    <div class="hero-title mt-4 text-white">
        RUN THE<br>
        <span class="outline-text">CITY</span> <span style="color:#d4ff00;">OWN</span><br>
        <span style="color:#ff5a30;">THE</span> ROAD.
    </div>

    <p class="text-secondary mt-4" style="max-width:400px; font-size:14px;">
        Not just another race list. Organisers launch in seconds, athletes enter in 2 taps. Results, medals, PBs — all in one place.
    </p>

    <div class="mt-4 d-flex gap-3">
        <a href="/Identity/Account/Register" class="btn" style="background:#ff5a30; color:white; font-weight:bold; border-radius:20px; padding:10px 25px; font-size:13px;">Start Racing — Free</a>
        <a href="#events" class="btn btn-outline-light" style="border-radius:20px; padding:10px 25px; font-size:13px;">Explore Races</a>
        <a href="/Organiser/Create" class="btn" style="background:#d4ff00; color:black; font-weight:bold; border-radius:20px; padding:10px 25px; font-size:13px;">+ Create Event</a>
    </div>

    <div class="d-flex gap-3 mt-5" style="max-width:500px;">
        <div class="stat-card"><div style="font-weight:900; font-size:20px; color:white;">127+</div><div style="font-size:10px; color:#999;">RACES / MONTH</div></div>
        <div class="stat-card"><div style="font-weight:900; font-size:20px; color:white;">14.2K</div><div style="font-size:10px; color:#999;">FINISHERS</div></div>
        <div class="stat-card"><div style="font-weight:900; font-size:20px; color:white;">9</div><div style="font-size:18px; font-weight:900; color:white;">PROVINCES<br>COVERED</div></div>
    </div>
</div>

<div class="ticker">
    RUNNING &nbsp; • &nbsp; TRAIL &nbsp; • &nbsp; WALKING &nbsp; • &nbsp; CYCLING &nbsp; • &nbsp; COMRADES QUALIFIER &nbsp; • &nbsp; 5K &nbsp; • &nbsp; 10K &nbsp; • &nbsp; 21K &nbsp; • &nbsp; 42K &nbsp; • &nbsp; RUNNING &nbsp; • &nbsp; TRAIL &nbsp; • &nbsp; WALKING &nbsp; • &nbsp; CYCLING &nbsp; • &nbsp; COMRADES QUALIFIER &nbsp; • &nbsp; 5K &nbsp; • &nbsp; 10K &nbsp; • &nbsp; 21K &nbsp; • &nbsp; 42K
</div>

<!-- UPCOMING RACES - NOW WITH YOUR POLOKWANE 10KM -->
<div id="events" class="container-fluid" style="padding:40px 60px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-white fw-bold m-0">Upcoming Races</h3>
        <div>
            <a href="/Organiser/Dashboard" class="btn btn-sm btn-outline-light me-2" style="border-radius:20px;">Dashboard</a>
            <a href="/Organiser/Create" class="btn btn-sm" style="background:#d4ff00; color:black; font-weight:bold; border-radius:20px;">+ Create Event</a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center p-5 rounded-4" style="background:#15151c; border:1px dashed #333;">
            <h5 class="text-white">No races yet — be the first in Polokwane!</h5>
            <p class="text-secondary">Create your 10KM now and it will show here with special badge</p>
            <a href="/Organiser/Create" class="btn mt-3" style="background:#d4ff00; color:black; font-weight:900; border-radius:25px; padding:12px 35px;">+ CREATE POLOKWANE 10KM NOW</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="race-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <span style="background:#d4ff00; color:black; font-size:10px; font-weight:900; padding:3px 8px; border-radius:10px;">@ev.EventType</span>
                            <span style="color:#666; font-size:11px;">@ev.Date.ToString("dd MMM yyyy")</span>
                        </div>
                        <h5 class="mt-3 fw-bold">@ev.Name</h5>
                        <div class="text-secondary" style="font-size:13px;">📍 @ev.Location • 🏃 @ev.Distance KM</div>
                        <div class="text-secondary mt-2" style="font-size:12px;">@ev.Description</div>
                        @if (ev.Location.ToLower().Contains("polokwane") && ev.Distance == 10)
                        {
                            <div class="mt-3"><span style="background:#d4ff00; color:black; font-weight:900; font-size:11px; padding:5px 10px; border-radius:10px;">⭐ YOUR 10KM POLOKWANE EVENT</span></div>
                        }
                        <a class="btn w-100 mt-3" style="background:white; color:black; font-weight:bold; border-radius:12px;">View Details →</a>
                    </div>
                </div>
            }
        </div>
    }
</div>